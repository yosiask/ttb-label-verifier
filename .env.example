# Copy to .env for local development. Never commit .env.
# Engine: local (offline Tesseract) | azure (cloud vision, errors if unavailable) | auto (cloud, falls back to offline)
EXTRACTOR=auto
MAX_UPLOAD_MB=10

# Azure OpenAI vision. Deployed app uses managed identity; an API key is for local dev only.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=label-vision
# AZURE_OPENAI_API_KEY=
AZURE_TIMEOUT_S=12
# Output budget per call. Azure counts it against tokens-per-minute on every request.
AZURE_MAX_OUTPUT_TOKENS=700
# If the deployment uses a user-assigned managed identity, its client ID.
# AZURE_CLIENT_ID=
# Run offline OCR alongside cloud vision to catch "auto-corrected" warning text.
VISION_OCR_CROSSCHECK=true

# Server-side usage protection (per replica, in memory).
RATE_LIMIT_PER_MINUTE=120
CLOUD_DAILY_CAP=1000
# Cloud calls per minute per replica (0 = no pacing). Deployed: about TPM x 0.8 / 1300 tokens per label / max replicas.
CLOUD_REQUESTS_PER_MINUTE=0
# Batch requests (wait_for_cloud=true) wait up to this long for a cloud slot before using offline OCR.
CLOUD_WAIT_S=45
MAX_CONCURRENT_VERIFICATIONS=4
QUEUE_WAIT_S=30
# 0 locally; 1 behind Azure Container Apps ingress (trust only the address it appends).
TRUSTED_PROXY_HOPS=0
