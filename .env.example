# Copy to .env for local development. Never commit .env.
# Extraction engine: local (offline Tesseract) | azure (cloud vision, Milestone 2) | auto
EXTRACTOR=local
MAX_UPLOAD_MB=10
# Azure OpenAI (Milestone 2). Production uses managed identity, not keys.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
